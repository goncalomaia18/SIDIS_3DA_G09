@startuml
autonumber
actor Client
participant "AircraftInstance1\n(Porta 8081)" as Inst1
participant "AircraftInstance2\n(Porta 8082)" as Inst2

Client -> Inst1: GET /api/aircrafts/123[cite: 25]
activate Inst1

Inst1 -> Inst1: Verifica base de dados local (Não encontrado)

alt Recurso não existe localmente
    Inst1 -> Inst2: GET /api/aircrafts/123 (Forwarding HTTP)
    activate Inst2
    Inst2 -> Inst2: Consulta base de dados local (Encontrado)
    Inst2 --> Inst1: Retorna dados da Aeronave
    deactivate Inst2

    Inst1 --> Client: Retorna dados ao Cliente
else Recurso existe localmente
    Inst1 --> Client: Retorna dados diretos
end

deactivate Inst1
@enduml